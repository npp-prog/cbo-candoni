# CFMS - Candoni Financial Management System
# Copy to .env.local for local development. In production these are set as
# Netlify environment variables, per deploy context, and never committed.
#
# NOTE ON SECRECY: the Firebase web config below is a public client identifier,
# not a password. It is safe for it to reach the browser. What actually protects
# municipal financial data is Firebase Authentication + Firestore Security Rules
# + Storage Security Rules + App Check + server-side authorisation in Cloud
# Functions. A Firebase *Admin* service-account key is a different thing entirely
# and must NEVER appear in this file or anywhere in the frontend.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (must match functions/src/index.ts)
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Firebase App Check - reCAPTCHA Enterprise site key for cbo.mgocandoni.com
VITE_APPCHECK_SITE_KEY=

# Set to "true" only on a developer machine to allow App Check debug tokens.
VITE_APPCHECK_DEBUG=false

# Point the app at the local emulator suite instead of a live Firebase project.
VITE_USE_EMULATORS=false

# Environment label shown in the header so staging is never mistaken for
# production: one of "development" | "staging" | "production"
VITE_ENVIRONMENT=development
