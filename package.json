{
  "name": "candoni-books-online",
  "private": true,
  "version": "0.1.0",
  "description": "CBO - Candoni Books Online. Integrated Municipal Financial Management System of the Municipal Government of Candoni, Negros Occidental.",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "emulators": "firebase emulators:start",
    "seed": "tsx scripts/seed.ts",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "check:rules": "node scripts/check-rules.mjs",
    "verify": "npm run check:rules && tsc --noEmit && npm test && npm run build && npm --prefix functions run build && npm --prefix functions test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "firebase-admin": "^13.10.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
