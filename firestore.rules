rules_version = '2';

// =============================================================================
// CFMS - Candoni Financial Management System
// Cloud Firestore Security Rules
// Municipal Government of Candoni, Negros Occidental
// =============================================================================
//
// DESIGN POSITION
// ---------------
// These rules are the real authorisation boundary. The React application's
// permission table decides what to *render*; this file decides what is
// *permitted*. Anyone holding a valid login can open a console and call the
// Firestore SDK directly, so every rule below assumes the client is hostile.
//
// Three tiers of write access:
//
//   SERVER ONLY   ledgerEntries, auditLogs, counters, budgetBalances,
//                 budgetSummaries, cashPositions, accountingPeriods,
//                 workflowHistory, notifications
//                 -> allow write: if false;  (Admin SDK bypasses rules)
//
//   ENGINE ONLY   status transitions on financial documents. A client may
//                 create and edit a DRAFT, but may not set status to
//                 CERTIFIED/APPROVED/POSTED/PAID - those come from callables.
//
//   CLIENT        drafts, master data, document metadata, own profile fields.
//
// Roles come from Firebase Auth custom claims, set only by the setUserRoles
// callable, which itself requires SUPER_ADMIN. A user cannot promote
// themselves by editing their own `users` document: the rules below deny
// writes to the `roles` field, and the claims - not the document - are what
// these rules read.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Identity helpers
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // App Check: reject requests that do not come from the attested CFMS app.
    // `request.auth.token` is present for signed-in users; App Check tokens are
    // surfaced separately and are enforced at the project level as well.
    function appChecked() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function roles() {
      return isSignedIn() && 'roles' in claims() ? claims().roles : [];
    }

    function hasRole(role) {
      return isSignedIn() && role in roles();
    }

    function hasAny(allowed) {
      return isSignedIn() && roles().hasAny(allowed);
    }

    function isAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isActive() {
      // Deactivated users keep a valid session until their token expires; the
      // `active` claim is refreshed on every sign-in and on any role change.
      return isSignedIn() && (!('active' in claims()) || claims().active == true);
    }

    function signedIn() {
      return isSignedIn() && isActive() && appChecked();
    }

    // --- Role groupings ------------------------------------------------------

    function accountingRoles() {
      return ['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER', 'ACCOUNTING_ENCODER'];
    }

    function budgetRoles() {
      return ['SUPER_ADMIN', 'BUDGET_OFFICER', 'BUDGET_STAFF'];
    }

    function treasuryRoles() {
      return ['SUPER_ADMIN', 'MUNICIPAL_TREASURER', 'TREASURY_STAFF'];
    }

    function masterDataWriters() {
      return ['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'BUDGET_OFFICER', 'MUNICIPAL_TREASURER'];
    }

    // Every authenticated, active user may read reference and transaction data;
    // office-level narrowing for DEPARTMENT_USER is applied per collection.
    function canRead() {
      return signedIn();
    }

    // -------------------------------------------------------------------------
    // Field-level helpers
    // -------------------------------------------------------------------------

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /**
     * Has a CERTIFIED treasury report claimed this document?
     *
     * `treasuryReportId` is stamped by certifyTreasuryReport, not when the
     * report is drafted - a draft is still being changed, so being on one is
     * not being reported.
     *
     * This is the gate on releasing a check and on sending an advice to the
     * bank. Until Accounting has the report, the General Ledger has never
     * heard of the payment, and a check released before that is the shape of
     * the loss that only turns up at the bank reconciliation weeks later.
     *
     * The same rule is stated for the screen in src/lib/releaseControl.ts, so
     * the button and the refusal cannot disagree.
     */
    function isOnCertifiedReport() {
      return 'treasuryReportId' in resource.data
        && resource.data.treasuryReportId != null
        && resource.data.treasuryReportId is string
        && resource.data.treasuryReportId.size() > 0;
    }

    function onlyChanged(allowedFields) {
      return changedKeys().hasOnly(allowedFields);
    }

    function didNotChange(protectedFields) {
      return !changedKeys().hasAny(protectedFields);
    }

    // A client may only ever put a financial document into one of these states.
    // Everything beyond DRAFT/SUBMITTED is an engine decision.
    function isClientWritableStatus(status) {
      return status in ['DRAFT', 'SUBMITTED'];
    }

    function isDraft() {
      return resource.data.status == 'DRAFT';
    }

    // The office restriction applied to DEPARTMENT_USER. An empty officeScope
    // claim means unrestricted (accounting, budget, treasury, audit).
    function officeAllowed(officeId) {
      return !hasRole('DEPARTMENT_USER')
        || !('officeScope' in claims())
        || claims().officeScope.size() == 0
        || officeId in claims().officeScope;
    }

    function fundAllowed(fundCode) {
      return !('fundScope' in claims())
        || claims().fundScope.size() == 0
        || fundCode in claims().fundScope;
    }

    // Creator stamp must be truthful: a user cannot create a document
    // attributed to somebody else.
    function createdByCaller() {
      return request.resource.data.createdBy.uid == request.auth.uid;
    }

    // =========================================================================
    // TIER 1 - SERVER ONLY
    // The accounting engine writes these through the Admin SDK, which bypasses
    // rules entirely. Denying all client writes here is what makes the General
    // Ledger trustworthy.
    // =========================================================================

    // The General Ledger. Immutable, append-only, written solely by postJev.
    match /ledgerEntries/{entryId} {
      allow read: if canRead();
      allow create, update, delete: if false;
    }

    // The audit trail. If a client could write here, the trail would be
    // worthless; if a client could delete here, it would be worse than
    // worthless.
    match /auditLogs/{logId} {
      // Read is limited to roles with an audit mandate. An encoder does not
      // need to browse everyone else's activity.
      allow read: if signedIn() && hasAny([
        'SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'BUDGET_OFFICER',
        'MUNICIPAL_TREASURER', 'ACCOUNTING_REVIEWER', 'AUDITOR'
      ]);
      allow create, update, delete: if false;
    }

    // Document number sequences. Client write access here would allow two
    // vouchers to share a number.
    match /counters/{counterId} {
      allow read: if false;
      allow write: if false;
    }

    /**
     * One document per manually assigned document number.
     *
     * The Obligation Request number is typed in by the Budget Office rather
     * than drawn from a counter, and two offices typing the same number on the
     * same day is exactly the sort of thing that is noticed a month later. The
     * reservation makes uniqueness a database constraint: the engine creates
     * the document inside the same transaction as the certification, and a
     * second attempt on the same number cannot create it.
     *
     * Engine only, like the counters. A client that could write here could
     * reserve a number it never uses, or free one already issued.
     */
    match /documentNumbers/{numberId} {
      allow read: if false;
      allow write: if false;
    }

    // Derived budget control balances.
    match /budgetBalances/{balanceId} {
      allow read: if canRead();
      allow write: if false;
    }

    match /budgetSummaries/{summaryId} {
      allow read: if canRead();
      allow write: if false;
    }

    /*
     * The budget year's estimated receipts - LBP Form No. 1, section II.
     *
     * Written only by the recordEstimatedReceipts callable. These authorise
     * nothing, so the usual argument for a server-only collection does not
     * apply; the argument that does is that they become the budget column of
     * the SRE, which is submitted to the DOF-BLGF, and the base of the LDRRMF
     * and Personal Services limits. A figure that leaves the municipality on a
     * signed form is not one a browser console should be able to set.
     *
     * The duplicate-account rule is also unenforceable from the client, which
     * cannot see what another tab is sending.
     */
    match /estimatedReceipts/{receiptId} {
      allow read: if canRead();
      allow write: if false;
    }

    /*
     * Whether the year's receipts schedule is closed to further change.
     *
     * Written only by recordEstimatedReceipts, which sets it, and
     * unlockEstimatedReceipts, which clears it and records who did. A client
     * able to write this could re-open the schedule without the unlock being
     * recorded anywhere, which is the whole of what the lock is for.
     */
    match /estimatedReceiptLocks/{lockId} {
      allow read: if canRead();
      allow write: if false;
    }

    /*
     * Trust Fund programmes - the Trust Fund's funding ceiling.
     *
     * Written only by the recordTrustProgram callable and by the functions
     * that certify a utilisation and approve a voucher. The programmed amount
     * is what a Funding Utilization Request is checked against, so it is the
     * same kind of figure as a released allotment and gets the same treatment:
     * a control figure is not one a browser console should be able to raise.
     *
     * The three balances on the document - utilised, disbursed and the two
     * derived from them - are maintained inside the transactions that write
     * the utilisations and the vouchers, exactly as budgetBalances are.
     */
    match /trustPrograms/{programId} {
      allow read: if canRead();
      allow write: if false;
    }

    match /cashPositions/{positionId} {
      allow read: if canRead();
      allow write: if false;
    }

    // Accounting period control. Opening a closed period is a privileged act
    // performed through the reopenPeriod callable, with a recorded reason.
    match /accountingPeriods/{periodId} {
      allow read: if canRead();
      allow write: if false;
    }

    // Workflow history is appended by the engine as a side effect of each
    // transition, never by a client.
    match /workflowHistory/{eventId} {
      allow read: if canRead();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      // A user may read their own notifications and those addressed to a role
      // they hold.
      allow read: if signedIn() && (
        resource.data.recipientUid == request.auth.uid
        || (resource.data.recipientRole != null && resource.data.recipientRole in roles())
      );
      // Marking as read is the only client-writable change.
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && onlyChanged(['read', 'readAt']);
      allow create, delete: if false;
    }

    // =========================================================================
    // TIER 2 - FINANCIAL DOCUMENTS
    // Clients may draft and submit. Certification, approval, posting, payment
    // and cancellation are engine-only status transitions.
    // =========================================================================

    // --- Budget: appropriations ---------------------------------------------

    match /appropriations/{id} {
      allow read: if canRead();

      allow create: if signedIn()
        && hasAny(budgetRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && fundAllowed(request.resource.data.fundCode);

      // A draft may be corrected in place by budget staff; once approved it is
      // frozen and may only be superseded by a supplemental or an adjustment.
      //
      // Patch 102 put a real Edit button on this, so what had been a
      // theoretical permission became a used path - and three things that did
      // not matter while nobody edited now do.
      //
      //   THE FUND IS CHECKED. `fundAllowed` was on create and not on update,
      //   so an officer scoped to the Trust Fund could edit a draft's fundCode
      //   and move a line into the General Fund. Both the stored fund and the
      //   submitted one are checked: the first so the line was theirs to touch
      //   at all, the second so it cannot be moved out of their scope.
      //
      //   THE YEAR AND THE FUND ARE FROZEN. A correction is a correction to
      //   THIS line. Changing either is recording a different appropriation
      //   over the top of one that may already have been read.
      //
      //   THE KIND IS FROZEN. Turning a draft Original into a Supplemental is
      //   not a correction but a claim that a different ordinance enacted it,
      //   and the two foot to different totals on the Appropriation Ledger.
      //
      // The status stays DRAFT. `isClientWritableStatus` also permits
      // SUBMITTED, which an appropriation has no concept of - a line parked
      // there would show neither the Edit button nor the Approve button and
      // could not be reached again from any screen.
      allow update: if signedIn()
        && hasAny(budgetRoles())
        && isDraft()
        && request.resource.data.status == 'DRAFT'
        && fundAllowed(resource.data.fundCode)
        && fundAllowed(request.resource.data.fundCode)
        && didNotChange(['createdBy', 'approvedBy', 'postedAt',
                         'fiscalYear', 'fundCode', 'kind']);

      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Budget: augmentations being prepared --------------------------------

    // One document per SET, holding every line of it. The shape is the control:
    // an augmentation is only valid as a set that comes to zero, and a draft
    // made of loose rows could be approved halfway.
    //
    // NOTHING HERE AFFECTS A BALANCE. A draft is the Budget Office's own
    // working paper - no appropriation moves, no allotment moves, nothing is
    // obligable against it. That is what makes it safe to let a client write
    // this collection directly, as it writes an appropriation draft.
    //
    // POSTING IS NOT DONE HERE. The engine posts the set, runs every check at
    // that moment, and refuses a second posting of the same reference. Once it
    // has, the Appropriation Ledger is the record and the draft is deleted -
    // which is why there is no POSTED status a client could claim without
    // having posted anything.
    match /augmentationDrafts/{id} {
      allow read: if canRead();

      allow create: if signedIn()
        && hasAny(budgetRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.instrument == 'AUGMENTATION'
        && fundAllowed(request.resource.data.fundCode);

      // Corrected in place while it is still a draft, which is the whole point
      // of there being one. The year, the fund and the instrument are frozen
      // for the same reason they are on an appropriation: a correction corrects
      // THIS set rather than quietly becoming a different one.
      allow update: if signedIn()
        && hasAny(budgetRoles())
        && resource.data.status == 'DRAFT'
        && request.resource.data.status == 'DRAFT'
        && fundAllowed(resource.data.fundCode)
        && fundAllowed(request.resource.data.fundCode)
        && didNotChange(['createdBy', 'fiscalYear', 'fundCode', 'instrument']);

      // Deleted when it has been posted, or when it is abandoned. Budget staff
      // may, because nothing in the books depends on it: the posted lines are
      // the record and they live in /appropriations.
      allow delete: if signedIn()
        && hasAny(budgetRoles())
        && fundAllowed(resource.data.fundCode);
    }

    // --- Budget: Allotment Release Orders, prepared ---------------------------

    // An order prepared by the Budget Office and awaiting the Budget Officer's
    // approval. NOTHING HERE MOVES AUTHORITY - no balance, no allotment line -
    // which is what makes it safe for budget staff to write directly.
    //
    // Releasing is `approveAro`, on the server, and it is the only thing that
    // may write APPROVED. A browser may only ever write DRAFT: a client that
    // could write APPROVED could mark an order released without releasing it,
    // and the prepared list would stop telling the truth about what is waiting.
    //
    // An approved order is frozen - it is the record of who prepared what, and
    // its id is what stops an uploaded release being prepared twice.
    match /aroDrafts/{id} {
      allow read: if canRead();

      allow create: if signedIn()
        && hasAny(budgetRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.get('aroNo', null) == null
        && fundAllowed(request.resource.data.fundCode);

      // Corrected while it waits - the purpose rewritten, a line added or
      // taken off. The year and fund are frozen: a correction corrects THIS
      // order rather than becoming a different one.
      allow update: if signedIn()
        && hasAny(budgetRoles())
        && resource.data.status == 'DRAFT'
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.get('aroNo', null) == null
        && fundAllowed(resource.data.fundCode)
        && fundAllowed(request.resource.data.fundCode)
        && didNotChange(['createdBy', 'fiscalYear', 'fundCode', 'source', 'reference']);

      // Discarded while it is still only prepared. Once approved it is the
      // record of a release and stays.
      allow delete: if signedIn()
        && hasAny(budgetRoles())
        && resource.data.status == 'DRAFT'
        && fundAllowed(resource.data.fundCode);
    }

    // --- Budget: allotments --------------------------------------------------

    match /allotments/{id} {
      allow read: if canRead();

      allow create: if signedIn()
        && hasAny(budgetRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && fundAllowed(request.resource.data.fundCode);

      allow update: if signedIn()
        && hasAny(budgetRoles())
        && isDraft()
        && isClientWritableStatus(request.resource.data.status)
        && didNotChange(['createdBy', 'approvedBy', 'allotmentNo', 'postedAt']);

      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Budget: obligations (OBR) ------------------------------------------

    match /obligations/{id} {
      allow read: if canRead() && officeAllowed(resource.data.officeId);

      // A department user may raise an obligation for their own office.
      allow create: if signedIn()
        && hasAny(budgetRoles().concat(['DEPARTMENT_USER', 'ACCOUNTING_ENCODER']))
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.disbursedAmount == 0
        && officeAllowed(request.resource.data.officeId)
        && fundAllowed(request.resource.data.fundCode);

      allow update: if signedIn()
        && hasAny(budgetRoles().concat(['DEPARTMENT_USER', 'ACCOUNTING_ENCODER']))
        && resource.data.status in ['DRAFT', 'RETURNED']
        && isClientWritableStatus(request.resource.data.status)
        && officeAllowed(resource.data.officeId)
        // The OBR number, the certification, the override record and every
        // consumption figure are engine property.
        && didNotChange([
          'obrNo', 'createdBy', 'certifiedBy', 'certifiedAt', 'override',
          'disbursedAmount', 'unpaidAmount',
          // The closing of the supporting documents. Written by the engine,
          // never by a client - a client that could write it could write it
          // back off, and the create rule on /documents would then be
          // consulting a value controlled by the person it constrains.
          'attachmentsLockedAt', 'attachmentsLockedBy'
        ]);

      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Accounting: disbursement vouchers -----------------------------------

    match /disbursementVouchers/{id} {
      allow read: if canRead() && officeAllowed(resource.data.officeId);

      allow create: if signedIn()
        && hasAny(accountingRoles().concat(['DEPARTMENT_USER']))
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && officeAllowed(request.resource.data.officeId)
        && fundAllowed(request.resource.data.fundCode);

      allow update: if signedIn()
        && hasAny(accountingRoles().concat(['DEPARTMENT_USER']))
        && resource.data.status in ['DRAFT', 'RETURNED']
        && isClientWritableStatus(request.resource.data.status)
        && officeAllowed(resource.data.officeId)
        && didNotChange([
          'dvNo', 'createdBy', 'approvedBy', 'certifiedBy',
          'jevId', 'jevNo', 'jevPostedAt', 'checkId', 'adaId',
          // Whether this voucher is the Treasurer's to pay. A browser that
          // could write either of these could put a voucher in front of the
          // Treasurer without anybody in Accounting having sent it, which is
          // the one decision the split between approving and sending exists
          // to make somebody take.
          'awaitingTransferToTreasury', 'forwardedToTreasury',
          // Engine property; see the obligation rule above.
          'attachmentsLockedAt', 'attachmentsLockedBy'
        ]);

      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Accounting: journal entry vouchers ----------------------------------

    match /jevs/{id} {
      allow read: if canRead();

      // Manual adjusting, correcting and closing entries are drafted in the
      // client; JEVs generated from a DV, RCD or payroll are created by the
      // engine.
      allow create: if signedIn()
        && hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER', 'ACCOUNTING_ENCODER'])
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.sourceType in ['MANUAL', 'ADJUSTING', 'CLOSING', 'PRIOR_PERIOD']
        && fundAllowed(request.resource.data.fundCode);

      // A posted JEV is immutable. This is the single most important update
      // rule in the file: without it, a posted entry could be edited after the
      // fact and the General Ledger would no longer be evidence of anything.
      //
      // An entry that has been APPROVED but not posted IS editable, and only
      // by the Municipal Accountant. The voucher it belongs to may already be
      // approved and even paid; none of that has written the books, and the
      // entry is still the Accountant's to correct until it does. Encoders and
      // reviewers stop at FOR_REVIEW: once the Accountant has approved the
      // entry, changing it is the Accountant's act.
      //
      // POSTED is absent from both lists on purpose. A posted entry is never
      // written from a browser. It is corrected by the engine: correctJev
      // reverses it and opens a fresh draft, and amendPostedJev rewrites it in
      // place while its month is open - both after checks no client can make,
      // and both leaving a record on the entry itself.
      allow update: if signedIn()
        && resource.data.status in ['DRAFT', 'FOR_REVIEW', 'APPROVED']
        && request.resource.data.status in ['DRAFT', 'FOR_REVIEW', 'APPROVED']
        && (
          (resource.data.status in ['DRAFT', 'FOR_REVIEW']
            && request.resource.data.status in ['DRAFT', 'FOR_REVIEW']
            && hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER', 'ACCOUNTING_ENCODER']))
          || hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT'])
        )
        && didNotChange(
          // `corrections` and `signedTotal` are the entry's own record of
          // having been changed after posting, and of no longer agreeing with
          // the document it came from. Both are written by the engine inside
          // the transaction that makes the change true. A browser that could
          // write either could erase the evidence of the edit it just made.
          //
          // `referenceNo` is conditional, and that is the point. On an entry
          // written in Accounting it is the office's own journal voucher or
          // memo number, typed by the person raising it. On an entry raised by
          // a document the reference IS that document, and repointing it at
          // another one leaves an entry describing paper that does not
          // describe it - which is the one change the Accountant asked to keep
          // locked when everything else was opened up.
          resource.data.sourceType in ['MANUAL', 'ADJUSTING', 'CLOSING', 'PRIOR_PERIOD']
            ? ['jevNo', 'createdBy', 'postedBy', 'postedAt', 'corrections', 'signedTotal',
               'reversesJevId', 'reversedByJevId', 'sourceType', 'sourceId']
            : ['jevNo', 'createdBy', 'postedBy', 'postedAt', 'corrections', 'signedTotal',
               'reversesJevId', 'reversedByJevId', 'sourceType', 'sourceId', 'referenceNo']
        );

      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Accounting: checks and ADA ------------------------------------------

    match /checks/{id} {
      allow read: if canRead();
      // Checks are issued by the engine so that the number can be verified
      // unique within the bank account inside a transaction.
      allow create: if false;
      // Release details are recorded by treasury; amounts and numbers are not
      // touchable from the client.
      allow update: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT']))
        && onlyChanged(['status', 'dateReleased', 'releasedToName', 'releasedToPosition', 'updatedBy'])
        && request.resource.data.status in ['FOR_SIGNATURE', 'SIGNED', 'RELEASED']
        // A check is not handed over until it is on a certified RCI.
        && (request.resource.data.status != 'RELEASED' || isOnCertifiedReport());
      allow delete: if false;
    }

    match /ada/{id} {
      allow read: if canRead();
      allow create: if false;
      allow update: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT']))
        && onlyChanged(['status', 'dateSubmittedToBank', 'bankReferenceNo', 'updatedBy'])
        && request.resource.data.status in ['PREPARED', 'SUBMITTED']
        // An advice does not go to the bank until it is on a certified RADAI.
        && (request.resource.data.status != 'SUBMITTED' || isOnCertifiedReport());
      allow delete: if false;
    }

    // --- Treasury payroll, and Accounting's cash advances and liquidations ---

    // Payroll belongs to Treasury: the payroll officer records it and disburses
    // it. It raises no journal entry of its own - the entry comes from the
    // RCDisb that reports the cash paid - so there is no jevId to protect here.
    // What must be protected is the link to that report: once an RCDisb has
    // claimed a payroll, the payroll's figures are evidence for an entry in the
    // General Ledger and cannot be edited from a browser.
    match /payrolls/{id} {
      allow read: if canRead() && officeAllowed(resource.data.officeId);
      allow create: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT']))
        && createdByCaller()
        && request.resource.data.status == 'DRAFT';
      allow update: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT']))
        && resource.data.status in ['DRAFT', 'RETURNED']
        && !('treasuryReportId' in resource.data)
        && isClientWritableStatus(request.resource.data.status)
        && didNotChange(['payrollNo', 'createdBy', 'approvedBy', 'treasuryReportId', 'treasuryReportNo']);
      allow delete: if signedIn() && isAdmin() && isDraft()
        && !('treasuryReportId' in resource.data);
    }

    match /cashAdvances/{id} {
      allow read: if canRead();
      // Created by the engine when a cash-advance DV is posted, so the
      // outstanding balance can never begin life out of step with the ledger.
      allow write: if false;
    }

    match /liquidations/{id} {
      allow read: if canRead() && officeAllowed(resource.data.officeId);
      allow create: if signedIn()
        && hasAny(accountingRoles().concat(['DEPARTMENT_USER']))
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && officeAllowed(request.resource.data.officeId);
      allow update: if signedIn()
        && hasAny(accountingRoles().concat(['DEPARTMENT_USER']))
        && resource.data.status in ['DRAFT', 'RETURNED']
        && isClientWritableStatus(request.resource.data.status)
        && didNotChange([
          'liquidationNo', 'createdBy', 'approvedBy', 'jevId', 'cashAdvanceId',
          // Engine property; see the obligation rule above.
          'attachmentsLockedAt', 'attachmentsLockedBy'
        ]);
      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // --- Treasury ------------------------------------------------------------

    match /collections/{id} {
      allow read: if canRead();
      allow create: if signedIn()
        && hasAny(treasuryRoles())
        && createdByCaller()
        && request.resource.data.status == 'ISSUED'
        && fundAllowed(request.resource.data.fundCode);
      /*
       * ---- EDITABLE UNTIL IT IS REPORTED ---------------------------------
       *
       * This rule used to allow only the payor's name, TIN and remarks to
       * change, on the principle that an official receipt issued to a citizen
       * is not editable - it is cancelled and reissued. That is the right
       * principle for the PAPER. It was the wrong rule for the ENCODING of it,
       * and the office said so: an OR number or an amount mistyped at the
       * counter could not be put right at all, and the only route left was to
       * cancel a receipt the taxpayer is holding.
       *
       * So what is protected is not the receipt. It is everything downstream
       * of it:
       *
       *   ONCE A CERTIFIED REPORT HAS CLAIMED IT, nothing changes. The
       *   Treasurer has sworn to a list and a total, Accounting has raised an
       *   entry from it, and the figure is in the General Ledger. A receipt
       *   that could be edited afterwards would move a posted entry's total
       *   with nothing anywhere saying it had moved.
       *
       *   A CANCELLED RECEIPT STAYS CANCELLED, so a cancellation cannot be
       *   quietly undone by editing the record back.
       *
       *   THE FUND AND THE YEAR NEVER CHANGE, because they decide which books
       *   and which period the money belongs to; moving a receipt between them
       *   by editing it would take it out of one set of reports and into
       *   another with no trace.
       *
       * Checked with get(...) rather than `in`, because withdrawing a report
       * sets the field to null - and a receipt released by a withdrawn report
       * has to be editable again, or withdrawing would be a one-way door.
       */
      allow update: if signedIn()
        && hasAny(treasuryRoles())
        && fundAllowed(resource.data.fundCode)
        && resource.data.get('treasuryReportId', null) == null
        && resource.data.status != 'CANCELLED'
        && request.resource.data.status in ['ISSUED', 'IN_RCD', 'DEPOSITED', 'CANCELLED']
        && didNotChange([
          'createdBy',
          'fiscalYear',
          'fundCode',
          // The engine's to write, at certification.
          'treasuryReportId',
          'treasuryReportNo',
          'treasuryReportType',
        ]);
      allow delete: if false;
    }

    // =========================================================================
    // ACCOUNTABLE FORMS
    //
    // Neither of these is writable from a browser, and that is the point of the
    // module. Whether a serial may be issued depends on every movement that has
    // ever touched it, and whether a report may be certified depends on the
    // receipts actually encoded against those serials. A rule cannot read a
    // whole ledger, so the decision belongs to the engine - and if the engine
    // is the only writer, a client that bypasses the screens changes nothing.
    // =========================================================================

    // The primary report is the layer above a collector's own RCD. Whether a
    // secondary may be gathered into it, and whether a collection day has
    // already been banked, both depend on every other report for the fund -
    // which a rule cannot read. So the engine is the only writer.
    // The ADA series and the explanations for the holes in it. Reserving a
    // number means drawing it from the same counter issueAda draws from, so
    // only the engine may write here - a client that could reserve without
    // advancing the counter would hand the same number to two officers.
    // Cash in Bank. Only what the bank originates is held here; checks, ADA
    // and deposits are read from their own registers, so a client that could
    // write a movement straight into this book would be creating a second,
    // silently disagreeing copy of a payment.
    match /bankLedgers/{id} {
      allow read: if canRead();
      allow write: if false; // setBankLedgerOpening only.
    }

    match /bankLedgerEntries/{id} {
      allow read: if canRead();
      allow write: if false; // recordBankLedgerEntry / voidBankLedgerEntry only.
    }

    match /adaNumbers/{id} {
      allow read: if canRead();
      allow write: if false; // reserveAdaNumbers / retire / voidSkipped only.
    }

    match /primaryReports/{id} {
      allow read: if canRead();
      allow write: if false; // savePrimaryReport / close / reopen / cancel only.
    }

    match /accountableFormMovements/{id} {
      allow read: if canRead();
      allow write: if false; // recordFormMovement / voidFormMovement only.
    }

    match /raafReports/{id} {
      allow read: if canRead();
      allow write: if false; // prepareRaaf / certifyRaaf / cancelRaaf only.
    }

    match /rcds/{id} {
      allow read: if canRead();
      allow create: if signedIn()
        && hasAny(treasuryRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT';
      allow update: if signedIn()
        && hasAny(treasuryRoles())
        && resource.data.status in ['DRAFT']
        && isClientWritableStatus(request.resource.data.status)
        && didNotChange(['rcdNo', 'createdBy', 'jevId']);
      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    // ---------------------------------------------------------------------
    // treasuryReports - RCI, RADAI, RCD, RCDisb and the three eRCDs
    //                    (COA Circular 2021-014, Annexes E, F and G)
    // ---------------------------------------------------------------------
    //
    // The handover between two offices, so the rules split along the same
    // line as the engine functions do. Treasury builds and edits the draft:
    // which documents the report covers is theirs to decide. Once the
    // Treasurer certifies it, the client can no longer touch it at all -
    // certifying, journalizing and withdrawing are engine functions, and
    // the number, the totals, the JEV link and the certification stamps are
    // beyond reach of any browser at every stage.
    //
    // Accounting is deliberately NOT given write access here. The Accountant
    // adjusts the entry and posts it through journalizeTreasuryReport, which
    // re-checks that the entry still foots to the certified total. Letting
    // the browser write the entry directly would put that check on the
    // wrong side of the trust boundary.
    // Opening balances. The marker document is written by the engine when the
    // opening journal entry is posted; nothing may write it from a browser.
    // Making this server-only is what stops an opening balance being created,
    // edited or removed without a posted journal entry behind it.
    match /openingBalances/{id} {
      allow read: if canRead();
      allow write: if false;
    }

    match /treasuryReports/{id} {
      allow read: if canRead();
      /*
       * The report number IS allowed on a draft, since patch 77.
       *
       * This rule used to refuse it outright, because CFMS issued the number
       * itself at certification and a number arriving from a browser could
       * only be a browser inventing one. Patch 77 changed that - the number is
       * the Treasurer's own, from the office's book, typed on the draft - and
       * this rule was not changed with it. Every attempt to save an RCI draft
       * was refused with "Missing or insufficient permissions", which names
       * neither the field nor the reason, and the Treasurer had no way to tell
       * what CFMS wanted.
       *
       * The number on a draft binds nothing. What makes it binding is the
       * reservation written by certifyTreasuryReport, in the transaction that
       * certifies - and that is a callable, which these rules do not gate.
       *
       * What a client still may not write is anything the engine decides: the
       * journal entry it was posted as, the certification, and the closing of
       * the supporting documents.
       */
      allow create: if signedIn()
        && hasAny(treasuryRoles())
        && createdByCaller()
        && request.resource.data.status == 'DRAFT'
        && !('jevId' in request.resource.data)
        && !('jevNo' in request.resource.data)
        && !('certifiedAt' in request.resource.data)
        && !('certifiedBy' in request.resource.data)
        && !('attachmentsLockedAt' in request.resource.data)
        && !('attachmentsLockedBy' in request.resource.data);
      allow update: if signedIn()
        && hasAny(treasuryRoles())
        && resource.data.status == 'DRAFT'
        && request.resource.data.status == 'DRAFT'
        && didNotChange([
          'reportType',
          // 'reportNo' is NOT here any more. A draft's number is the office's
          // own and may be corrected while it is still a draft; it is reserved
          // against the report only when the report is certified.
          'fiscalYear',
          'fundCode',
          'createdBy',
          'status',
          'jevId',
          'jevNo',
          'certifiedAt',
          'certifiedBy',
          'journalizedAt',
          'postedBy',
          // The link to the uploaded file and the count of its rows still held.
          // certifyTreasuryReport refuses while that count is above zero, so a
          // browser able to write it could certify a report covering less than
          // the file it was made from. The control has to sit here, not only in
          // the function that reads it.
          'importId',
          'pendingRowCount',
          // Engine property; see the obligation rule above.
          'attachmentsLockedAt',
          'attachmentsLockedBy',
        ]);
      allow delete: if signedIn() && isAdmin() && resource.data.status == 'DRAFT';
    }

    // ---------------------------------------------------------------------
    // treasuryImports - uploaded RCI and RADAI files
    // ---------------------------------------------------------------------
    //
    // Read-only to every browser. The upload decides which vouchers were
    // paid and raises the checks and ADA against them, and whether a row
    // matched is the engine's finding, not a field anybody may set. A client
    // that could write here could mark a held row matched without a payment
    // behind it, and certify a report on the strength of it.
    match /treasuryImports/{id} {
      allow read: if canRead();
      allow write: if false;
    }

    match /deposits/{id} {
      allow read: if canRead();
      allow create: if signedIn()
        && hasAny(treasuryRoles())
        && createdByCaller()
        && request.resource.data.status == 'RECORDED';
      allow update: if signedIn()
        && hasAny(treasuryRoles())
        && resource.data.status == 'RECORDED'
        && didNotChange(['createdBy', 'jevId', 'bankTransactionId', 'creditedDate']);
      allow delete: if false;
    }

    // --- Reconciliation ------------------------------------------------------

    match /bankTransactions/{id} {
      allow read: if canRead();
      // Statement lines are ingested by the importBankStatement callable so
      // that duplicate imports are detected server-side.
      allow create: if false;
      // A reconciler may confirm or override a proposed match, and nothing else.
      allow update: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER']))
        && onlyChanged([
          'matchStatus', 'matchedType', 'matchedId', 'matchedRef',
          'matchMethod', 'matchConfidence', 'remarks', 'reconciliationId'
        ]);
      allow delete: if false;
    }

    match /bankReconciliations/{id} {
      allow read: if canRead();
      allow create: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER']))
        && createdByCaller()
        && request.resource.data.status == 'DRAFT';
      allow update: if signedIn()
        && hasAny(treasuryRoles().concat(['MUNICIPAL_ACCOUNTANT', 'ACCOUNTING_REVIEWER']))
        && resource.data.status in ['DRAFT', 'IN_PROGRESS', 'FOR_REVIEW']
        && request.resource.data.status in ['DRAFT', 'IN_PROGRESS', 'FOR_REVIEW']
        // Finalisation is an engine act; it re-derives the book balance from
        // the ledger and refuses a non-zero difference.
        && didNotChange(['createdBy', 'finalizedAt', 'balancePerBooks', 'adjustedBookBalance']);
      allow delete: if signedIn() && isAdmin() && isDraft();
    }

    match /importBatches/{id} {
      allow read: if canRead();
      allow write: if false;
    }

    // =========================================================================
    // TIER 3 - MASTER DATA
    // Read by everyone, written by senior roles. Never hard-deleted: master
    // records are deactivated so that historical documents referencing them
    // still resolve.
    // =========================================================================

    function masterRead() {
      return canRead();
    }

    function masterWrite() {
      return signedIn() && hasAny(masterDataWriters());
    }

    match /funds/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && isAdmin();
      allow delete: if false;
    }

    match /accounts/{id} {
      allow read: if masterRead();
      // The chart of accounts is the backbone of every report; changing an
      // account's classification silently restates prior periods. Restricted to
      // the Accountant and administrators.
      allow create, update: if signedIn() && hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /offices/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    /*
     * The barangays, for the real property tax shares.
     *
     * The Treasurer keeps this list: the barangay share of the basic tax
     * follows the property, and which barangay a property stands in is read
     * off the Real Property Tax Account Register, which is the Treasurer's
     * book. The Accountant writes it too, because the Accountant is the one
     * who draws the abstract that remits the shares.
     */
    match /barangays/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() &&
        hasAny(['SUPER_ADMIN', 'MUNICIPAL_TREASURER', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /responsibilityCenters/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    match /programs/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    match /projects/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    match /activities/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    // Who collects on the municipality's behalf. Master data, written by the
    // same people who keep the banks and the revenue codes - and by Treasury
    // staff, because an intermediary turns up for the first time while a
    // collection is being recorded, exactly as a payee does mid-voucher.
    match /intermediaries/{id} {
      allow read: if masterRead();
      allow create: if signedIn() && hasAny(masterDataWriters().concat(['TREASURY_STAFF']));
      allow update: if masterWrite();
      allow delete: if false;
    }

    match /payees/{id} {
      allow read: if masterRead();
      // Encoders need to add a supplier mid-voucher; blocking that guarantees
      // duplicate payee records created under vague names.
      allow create: if signedIn() && hasAny(masterDataWriters().concat(['ACCOUNTING_ENCODER', 'TREASURY_STAFF', 'BUDGET_STAFF']));
      allow update: if masterWrite();
      allow delete: if false;
    }

    match /employees/{id} {
      allow read: if masterRead();
      allow create, update: if masterWrite();
      allow delete: if false;
    }

    match /banks/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && hasAny(['SUPER_ADMIN', 'MUNICIPAL_TREASURER', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /bankAccounts/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && hasAny(['SUPER_ADMIN', 'MUNICIPAL_TREASURER', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /taxCodes/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    // Which COA account each of the Treasurer's revenue codes posts to. This
    // decides where a collection lands in the General Ledger, so it is the
    // Accountant's to set - the Treasurer's office owns the codes, Accounting
    // owns their classification. Never deleted: a mapping that posted last
    // year's collections has to stay readable to explain them.
    match /revenueCodes/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /accountableFormTypes/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn()
        && hasAny(['SUPER_ADMIN', 'MUNICIPAL_TREASURER', 'MUNICIPAL_ACCOUNTANT']);
      allow delete: if false;
    }

    match /fiscalYears/{id} {
      allow read: if masterRead();
      allow write: if false; // Opened and closed through the engine.
    }

    match /numberingRules/{id} {
      allow read: if masterRead();
      allow create, update: if signedIn() && isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // TIER 4 - SYSTEM
    // =========================================================================

    match /users/{uid} {
      // A user reads their own profile; administrators and audit read all.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'AUDITOR'])
      );

      // Profiles are provisioned by the engine on first sign-in.
      allow create: if false;

      // A user may maintain their own display details. Roles, scopes and the
      // active flag are set only by setUserRoles, which requires SUPER_ADMIN -
      // this rule is what stops privilege escalation from the browser.
      allow update: if signedIn()
        && request.auth.uid == uid
        && onlyChanged(['displayName', 'position', 'lastLoginAt']);

      allow delete: if false;
    }

    match /roleDefinitions/{id} {
      allow read: if canRead();
      allow create, update: if signedIn() && isAdmin();
      allow delete: if signedIn() && isAdmin() && resource.data.builtIn == false;
    }

    match /documents/{id} {
      allow read: if canRead();

      /*
       * Whether the transaction this file is being attached to is still open
       * to attachments.
       *
       * A replacement in CFMS is a NEW metadata record with the next version
       * number - nothing is overwritten - so refusing the create is what
       * closes the door. The lock itself lives on the parent document, written
       * only by the engine (lockAttachments, and certifyObligation), and no
       * rule in this file lets a client write it.
       *
       * The parent may legitimately not exist: an attachment is sometimes
       * filed before the record is saved under its final id. That is open, not
       * closed - there is nothing there to have been closed.
       */
      function attachmentsOpen(entityType, entityId) {
        return !exists(/databases/$(database)/documents/$(entityType)/$(entityId))
          || !('attachmentsLockedAt' in get(/databases/$(database)/documents/$(entityType)/$(entityId)).data);
      }

      // Metadata is written by the client after a successful Storage upload;
      // the Storage rules independently constrain size, type and path.
      allow create: if signedIn()
        && request.resource.data.uploadedBy.uid == request.auth.uid
        && request.resource.data.version is int
        && request.resource.data.active == true
        && attachmentsOpen(request.resource.data.entityType, request.resource.data.entityId);

      /*
       * Attachments are superseded, not edited. Only the supersession pointer
       * and the active flag may change, so a document's provenance is stable.
       *
       * ---- AND NOT AFTER THE PAPERS ARE CLOSED --------------------------
       *
       * `attachmentsOpen` was on the CREATE only, which left the lock half
       * built: nothing further could be ATTACHED to a certified record, but a
       * browser could still set active:false on what was already there - and
       * an attachment with active:false is off the record as far as every
       * screen and every report is concerned.
       *
       * So the papers behind a certified obligation, an approved voucher or a
       * certified treasury report could be made to disappear by a signed-in
       * user, and the closing - whose entire purpose is to say THESE are the
       * documents and they have not changed - would have said nothing.
       *
       * Checked against `resource`, the record as it stands, not
       * `request.resource`: the parent a client claims the attachment belongs
       * to is not the question.
       */
      allow update: if signedIn()
        && onlyChanged(['active', 'supersededByDocumentId', 'description', 'documentType', 'documentDate'])
        && attachmentsOpen(resource.data.entityType, resource.data.entityId);

      allow delete: if signedIn() && isAdmin();
    }

    match /settings/{key} {
      allow read: if canRead();

      /*
       * Administrators write any setting, and nobody else writes one here.
       *
       * Two exceptions used to sit in this block and both are gone, for the
       * same reason each time: a write permission for a store nothing reads
       * any more is a door into a room that has been demolished. Harmless
       * until somebody writes to it and spends an afternoon wondering why the
       * report does not change.
       *
       *   statutoryLimits-{year}   held the three figures behind the Statutory
       *                            Limits screen, which has been removed.
       *   incomeEstimates-{year}-{fund}
       *                            held the quarterly income estimates behind
       *                            LBAc Form No. 1. Those live in the
       *                            estimatedReceipts collection now, written
       *                            by a callable.
       *
       * The settings that DO have their own writers keep them in the blocks
       * below, one match per document, so each widening is visibly one
       * document and not every setting in the system.
       */
      allow write: if signedIn() && isAdmin();
    }

    /*
     * The SRE revenue mapping is an accounting classification, not a system
     * setting.
     *
     * Which revenue account belongs on "Regulatory Fees" rather than
     * "Service/User Charges" is a judgement the Municipal Accountant and the
     * Municipal Treasurer make and answer to COA for. Requiring a system
     * administrator to type it in on their behalf would put the decision in
     * one office and the knowledge in another, and the usual result of that is
     * an administrator account shared around.
     *
     * A separate match rather than a change to the one above, so the widening
     * is visibly one document and not every setting in the system. Firestore
     * grants access when ANY matching rule allows it, so administrators keep
     * their write through the block above.
     */
    match /settings/sreMapping {
      allow read: if canRead();
      allow write: if signedIn() &&
        hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'MUNICIPAL_TREASURER']);
    }

    /*
     * The Statement of Comparison of Budget and Actual Amounts carries two
     * decisions of the same kind, and they belong to the same offices.
     *
     * Which annex line a sector of the appropriation ordinance sits on: Annex 8
     * prints the national list and Candoni's ordinance does not use it, so
     * "Allocation for Senior Citizens and PWD" has to be placed by somebody who
     * knows what it funds.
     *
     * And what the Actual column counts - obligations incurred or
     * disbursements paid. Section 373 says only "the amounts that result from
     * execution of the budget", and the municipality answers to COA for which
     * reading it submits.
     *
     * The Budget Officer is included here and not on the SRE mapping above:
     * the sectors are the ordinance's, which is the Budget Office's document.
     */
    match /settings/scbaa {
      allow read: if canRead();
      allow write: if signedIn() &&
        hasAny(['SUPER_ADMIN', 'MUNICIPAL_ACCOUNTANT', 'MUNICIPAL_TREASURER', 'BUDGET_OFFICER']);
    }


    // =========================================================================
    // DEFAULT DENY
    // Any collection not named above is inaccessible. New collections must be
    // granted access deliberately rather than inheriting it.
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
